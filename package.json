{
  "name": "outline-sync-obsidian",
  "version": "0.1.0",
  "description": "Two-way sync between an Obsidian vault and an Outline wiki",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.6.0"
  }
}
